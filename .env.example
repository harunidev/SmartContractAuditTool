# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Anthropic API key — required for AI analysis
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use for AI analysis (optional)
# Options: claude-opus-4-7 (default, most thorough)
#          claude-sonnet-4-6 (faster, cheaper)
#          claude-haiku-4-5-20251001 (fastest)
AUDIT_MODEL=claude-opus-4-7

# Web server settings (optional)
AUDIT_WEB_HOST=0.0.0.0
AUDIT_WEB_PORT=5000
AUDIT_WEB_DEBUG=false
